{
	"$schema": "https://biomejs.dev/schemas/2.3.6/schema.json",
	"vcs": {
		"clientKind": "git",
		"enabled": true,
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": true,
		"maxSize": 10000000,
		"includes": [
			"**",
			"!**/node_modules",
			"!**/.next",
			"!**/dist",
			"!**/build",
			"!**/coverage"
		]
	},
	"formatter": {
		"enabled": true,
		"formatWithErrors": false,
		"indentStyle": "tab",
		"indentWidth": 2,
		"lineEnding": "lf",
		"lineWidth": 80,
		"attributePosition": "auto",
		"bracketSameLine": false,
		"bracketSpacing": true,
		"useEditorconfig": true
	},
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"a11y": {
				"recommended": true
			},
			"complexity": {
				"recommended": true,
				"noUselessFragments": "error",
				"useOptionalChain": "error"
			},
			"correctness": {
				"recommended": true,
				"noUnusedVariables": "error",
				"useExhaustiveDependencies": "warn",
				"useHookAtTopLevel": "error"
			},
			"security": {
				"noDangerouslySetInnerHtml": "warn"
			},
			"style": {
				"recommended": true,
				"noNonNullAssertion": "warn",
				"useBlockStatements": "off",
				"useConst": "error",
				"useImportType": "error",
				"useNodejsImportProtocol": "error",
				"useSelfClosingElements": "error",
				"useTemplate": "error"
			},
			"suspicious": {
				"recommended": true,
				"noArrayIndexKey": "warn",
				"noConsole": {
					"level": "warn",
					"options": {
						"allow": ["warn", "error", "info"]
					}
				},
				"noDebugger": "warn",
				"noDoubleEquals": "error",
				"noExplicitAny": "warn"
			}
		}
	},
	"javascript": {
		"formatter": {
			"arrowParentheses": "always",
			"bracketSameLine": false,
			"bracketSpacing": true,
			"jsxQuoteStyle": "single",
			"quoteProperties": "asNeeded",
			"quoteStyle": "single",
			"semicolons": "asNeeded",
			"trailingCommas": "es5"
		}
	},
	"json": {
		"formatter": {
			"trailingCommas": "none"
		}
	},
	"css": {
		"parser": {
			"cssModules": true,
			"tailwindDirectives": true
		},
		"formatter": {
			"enabled": true,
			"quoteStyle": "double"
		}
	},
	"overrides": [
		{
			"includes": ["**/*.{test,spec}.{ts,tsx}"],
			"linter": {
				"rules": {
					"suspicious": {
						"noExplicitAny": "off"
					}
				}
			}
		},
		{
			"includes": ["vitest.setup.ts", "vitest.config.ts", "vitest.config.mts"],
			"linter": {
				"rules": {
					"suspicious": {
						"noExplicitAny": "off"
					}
				}
			}
		},
		{
			"includes": ["src/components/atoms/Icons/**/*.tsx"],
			"linter": {
				"rules": {
					"a11y": {
						"noSvgWithoutTitle": "off",
						"useSemanticElements": "off"
					}
				}
			}
		},
		{
			"includes": ["src/components/atoms/Label/**/*.tsx"],
			"linter": {
				"rules": {
					"a11y": {
						"noLabelWithoutControl": "off"
					}
				}
			}
		},
		{
			"includes": ["vitest.setup.ts"],
			"linter": {
				"rules": {
					"a11y": {
						"useButtonType": "off"
					},
					"suspicious": {
						"noExplicitAny": "off"
					}
				}
			}
		}
	]
}
