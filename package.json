{
	"name": "ion-starter-kit",
	"version": "1.0.0",
	"private": true,
	"authors": [
		"Rodrigo Santos <rodrigosantos@ioasys.com.br>"
	],
	"description": "A starter kit for building applications with @ioasys/ion and Next.js.",
	"engines": {
		"node": ">=22.0.0",
		"yarn": "use npm!"
	},
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"lint:report": "biome check --reporter=json > biome-report.json && node ./scripts/biome-to-eslint.js ./biome-report.json",
		"format": "biome format .",
		"format:check": "biome format --check .",
		"lint:staged": "lint-staged",
		"check-types": "tsc --noemit",
		"prepare": "husky",
		"test": "vitest",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage"
	},
	"dependencies": {
		"@ioasys/ion": "^0.4.2",
		"next": "15.5.7",
		"react": "19.2.0",
		"react-dom": "19.2.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.6",
		"@tailwindcss/postcss": "4.1.17",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.0",
		"@types/node": "^20",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"@vitejs/plugin-react": "^5.1.1",
		"husky": "^9.1.7",
		"jsdom": "^27.2.0",
		"lint-staged": "^16.2.6",
		"tailwindcss": "4.1.17",
		"typescript": "^5",
		"vitest": "^4.0.10"
	},
	"overrides": {
		"react": "$react",
		"react-dom": "$react-dom"
	}
}
