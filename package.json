{
	"name": "ion-starter-kit",
	"version": "1.0.0",
	"private": true,
	"authors": [
		"Rodrigo Santos <rodrigosantos@ioasys.com.br>"
	],
	"description": "A starter kit for building applications with @ioasys/ion-react and Next.js.",
	"engines": {
		"node": ">=22.0.0",
		"yarn": "use npm!"
	},
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"lint:report": "biome check --reporter=json > biome-report.json && node ./scripts/biome-to-eslint.js ./biome-report.json",
		"format": "biome format .",
		"format:check": "biome format --check .",
		"lint:staged": "lint-staged",
		"check-types": "tsc --noemit",
		"prepare": "husky",
		"test": "vitest",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage"
	},
	"dependencies": {
		"@ioasys/ion-react": "^0.6.5",
		"next": "16.2.9",
		"react": "19.2.7",
		"react-dom": "19.2.7"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.16",
		"@tailwindcss/postcss": "4.3.0",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@types/node": "^25",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"@vitejs/plugin-react": "^6.0.2",
		"husky": "^9.1.7",
		"jsdom": "^29.1.1",
		"lint-staged": "^17.0.7",
		"tailwindcss": "4.3.0",
		"typescript": "^6",
		"vite": "^8.0.0",
		"vitest": "^4.1.8"
	},
	"overrides": {
		"react": "$react",
		"react-dom": "$react-dom",
		"postcss": "^8.5.14"
	}
}
